{
  "_comentario": "Mapeamento entre campos amigáveis (busca.json) e seletores DOM (Puppeteer)",
  "_instrucoes": "Este arquivo mapeia os nomes amigáveis para os seletores reais do DOM e valores técnicos",

  "extraction": {
    "_comment": "Seletores para extração de dados dos resultados da pesquisa",

    "resultados": {
      "selector": "tr.fundocinza1",
      "_description": "Container de cada resultado (cada acórdão)"
    },

    "paginacao": {
      "selector": "#paginacaoSuperior-A",
      "_description": "Div de paginação superior",
      "regex_resultados": "Resultados\\s+(\\d+)\\s+a\\s+(\\d+)\\s+de\\s+(\\d+)",
      "selector_pagina_atual": "span.paginacaoResultados"
    },

    "numero_processo": {
      "selector": "a.esajLinkLogin.downloadEmenta[cdacordao]",
      "_description": "Número do processo/acórdão",
      "extraction": "text"
    },

    "pdf_url": {
      "selector": "a.downloadEmenta[cdacordao]",
      "attribute": "cdacordao",
      "_description": "Código do acórdão para gerar URL do PDF",
      "url_template": "https://esaj.tjsp.jus.br/cjsg/getArquivo.do?cdAcordao={cdacordao}&conversao=pdf"
    },

    "classe_assunto": {
      "selector": "tr.ementaClass2 td strong",
      "label": "Classe/Assunto:",
      "_description": "Classe processual e assunto",
      "extraction": "text_after_label"
    },

    "relator": {
      "selector": "tr.ementaClass2",
      "label": "Relator(a):",
      "_description": "Nome do relator",
      "extraction": "text_after_label_in_rows"
    },

    "comarca": {
      "selector": "tr.ementaClass2",
      "label": "Comarca:",
      "_description": "Comarca de origem",
      "extraction": "text_after_label_in_rows"
    },

    "orgao_julgador": {
      "selector": "tr.ementaClass2",
      "label": "Órgão julgador:",
      "_description": "Órgão julgador (Câmara, Turma, etc.)",
      "extraction": "text_after_label_in_rows"
    },

    "data_julgamento": {
      "selector": "tr.ementaClass2",
      "label": "Data do julgamento:",
      "_description": "Data de julgamento",
      "extraction": "text_after_label_in_rows",
      "format": "DD/MM/YYYY"
    },

    "data_publicacao": {
      "selector": "tr.ementaClass2",
      "label": "Data de publicação:",
      "_description": "Data de publicação",
      "extraction": "text_after_label_in_rows",
      "format": "DD/MM/YYYY"
    },

    "ementa": {
      "selector": "tr.ementaClass2 td[colspan=\"2\"] div[align=\"justify\"]",
      "_description": "Ementa completa do acórdão",
      "extraction": "text_with_hidden_sibling",
      "label": "Ementa:"
    }
  },

  "fields": {
    "Pesquisa livre": {
      "technicalName": "buscaInteiroTeor",
      "selector": "input[name=\"dados.buscaInteiroTeor\"]",
      "type": "text",
      "label": "Pesquisa livre"
    },
    "Pesquisa livre (ementa)": {
      "technicalName": "buscaEmenta",
      "selector": "input[name=\"dados.buscaEmenta\"]",
      "type": "text",
      "label": "Pesquisa livre (ementa)"
    },
    "Número do processo": {
      "technicalName": "nuProcOrigem",
      "selector": "input[name=\"dados.nuProcOrigem\"]",
      "type": "text",
      "label": "Número do processo"
    },
    "Número do registro": {
      "technicalName": "nuRegistro",
      "selector": "input[name=\"dados.nuRegistro\"]",
      "type": "text",
      "label": "Número do registro"
    },
    "Data de julgamento (início)": {
      "technicalName": "dtJulgamentoInicio",
      "selector": "input[name=\"dados.dtJulgamentoInicio\"]",
      "type": "text",
      "label": "Data de julgamento (início)"
    },
    "Data de julgamento (fim)": {
      "technicalName": "dtJulgamentoFim",
      "selector": "input[name=\"dados.dtJulgamentoFim\"]",
      "type": "text",
      "label": "Data de julgamento (fim)"
    },
    "Data de publicação (início)": {
      "technicalName": "dtPublicacaoInicio",
      "selector": "input[name=\"dados.dtPublicacaoInicio\"]",
      "type": "text",
      "label": "Data de publicação (início)"
    },
    "Data de publicação (fim)": {
      "technicalName": "dtPublicacaoFim",
      "selector": "input[name=\"dados.dtPublicacaoFim\"]",
      "type": "text",
      "label": "Data de publicação (fim)"
    },
    "Nome do agente": {
      "technicalName": "nmAgente",
      "selector": "input[name=\"nmAgente\"]",
      "type": "text",
      "label": "Nome do agente"
    },
    "Nome do juiz": {
      "technicalName": "nmJuiz",
      "selector": "input[name=\"nmJuiz\"]",
      "type": "text",
      "label": "Nome do juiz"
    },
    "Nome da comarca": {
      "technicalName": "nmComarca",
      "selector": "input[name=\"nmComarca\"]",
      "type": "text",
      "label": "Nome da comarca"
    },
    "Classe processual": {
      "technicalName": "classesTreeSelection",
      "selector": "input[name=\"classesTreeSelection.text\"]",
      "type": "text",
      "label": "Classe processual"
    },
    "Assunto": {
      "technicalName": "assuntosTreeSelection",
      "selector": "input[name=\"assuntosTreeSelection.text\"]",
      "type": "text",
      "label": "Assunto"
    },
    "Seção": {
      "technicalName": "secoesTreeSelection",
      "selector": "input[name=\"secoesTreeSelection.text\"]",
      "type": "text",
      "label": "Seção"
    },
    "Código da Câmara/Grupo": {
      "technicalName": "codigoCr",
      "selector": "input[name=\"codigoCr\"]",
      "type": "text",
      "label": "Código da Câmara/Grupo"
    },
    "Código do Tribunal": {
      "technicalName": "codigoTr",
      "selector": "input[name=\"codigoTr\"]",
      "type": "text",
      "label": "Código do Tribunal"
    },
    "Código do juiz (Câmara)": {
      "technicalName": "codigoJuizCr",
      "selector": "input[name=\"codigoJuizCr\"]",
      "type": "text",
      "label": "Código do juiz (Câmara)"
    },
    "Código do juiz (Tribunal)": {
      "technicalName": "codigoJuizTr",
      "selector": "input[name=\"codigoJuizTr\"]",
      "type": "text",
      "label": "Código do juiz (Tribunal)"
    },
    "Código da comarca": {
      "technicalName": "cdComarca",
      "selector": "input[name=\"cdComarca\"]",
      "type": "text",
      "label": "Código da comarca"
    },
    "Pesquisar com sinônimos": {
      "technicalName": "pesquisarComSinonimos",
      "selector": "input[name=\"dados.pesquisarComSinonimos\"]",
      "type": "checkbox",
      "label": "Pesquisar com sinônimos"
    },
    "Origem": {
      "technicalName": "origensSelecionadas",
      "selector": "input[name=\"dados.origensSelecionadas\"]",
      "type": "checkbox-group",
      "label": "Origem",
      "values": {
        "2° grau": "T",
        "Colégios Recursais": "R"
      }
    },
    "Tipo de decisão": {
      "technicalName": "tipoDecisaoSelecionados",
      "selector": "input[name=\"tipoDecisaoSelecionados\"]",
      "type": "checkbox-group",
      "label": "Tipo de decisão",
      "values": {
        "Acórdãos": "A",
        "Homologações": "H",
        "Decisões Monocráticas": "D"
      }
    },
    "Ordenar por": {
      "technicalName": "ordenarPor",
      "selector": "input[name=\"dados.ordenarPor\"]",
      "type": "radio",
      "label": "Ordenar por",
      "values": {
        "Data de Publicação": "dtPublicacao",
        "Relevância": "relevancia"
      }
    }
  }
}
