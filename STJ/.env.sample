# Browserless API Configuration
# Obtenha sua API Key em: https://www.browserless.io/
BROWSERLESS_API_KEY=YOUR_BROWSERLESS_API_KEY_HERE
# Regiões disponíveis: production-sfo (US West), production-lon (Europe), production-nyc (US East)
BROWSERLESS_REGION=production-sfo

# STJ URL Base (página de pesquisa de jurisprudência com reCAPTCHA v2)
STJ_URL=https://scon.stj.jus.br/SCON/jurisprudencia/toc.jsp

# OpenAI API Configuration
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Pinecone Vector Database Configuration
# Obtenha sua chave em: https://app.pinecone.io/
# O índice será criado automaticamente se não existir
PINECONE_API_KEY=pcsk_YOUR_PINECONE_API_KEY_HERE
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws
PINECONE_INDEX_NAME=jurisprudencias-stj
PINECONE_DIMENSION=1536
PINECONE_TYPE=DENSE
PINECONE_CAPACITY_MODE=SERVERLESS

