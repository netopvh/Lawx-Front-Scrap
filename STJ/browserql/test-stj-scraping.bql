# ═══════════════════════════════════════════════════════════════════════
# TEST: Extração de Dados STJ
# ═══════════════════════════════════════════════════════════════════════
#
# OBJETIVO:
# Testar a extração de dados de jurisprudências do STJ após submeter o formulário.
#
# COMO USAR:
# 1. Acesse: https://www.browserless.io/playground
# 2. Configure sua API Key no botão ¦¦¦ (Settings)
# 3. Cole esta query no editor
# 4. Clique em ▶️ Run
#
# RESULTADO ESPERADO:
# - Formulário preenchido e submetido
# - Lista de jurisprudências extraídas
# - Screenshot da página de resultados
#
# SELETORES CSS USADOS (baseados em fields.json):
# - .jurisprudenciaResultado - Container de cada resultado
# - .docEntryData - Dados do documento
# - .numeroProcesso - Número do processo
# - .dataPublicacao - Data de publicação
# - .ementa - Ementa da jurisprudência
#
# NOTA:
# Esta query pode falhar se houver CAPTCHA. Use apenas para testes visuais.
# ═══════════════════════════════════════════════════════════════════════

mutation TestSTJScraping {

  # Navegar para página de pesquisa do STJ
  step1_goto: goto(
    url: "https://scon.stj.jus.br/SCON/jurisprudencia/toc.jsp",
    waitUntil: networkIdle
  ) {
    status
  }

  # Aguardar carregamento do formulário
  step2_waitForSelector: waitForSelector(selector: "input[name='livre']", timeout: 10000) {
    success
  }

  # Preencher campo "Pesquisa livre"
  step3_type: type(selector: "input[name='livre']", text: "Advogado") {
    success
  }

  # Selecionar tribunal "STJ" (seletor correto: name="b")
  step4_select: select(selector: "select[name='b']", value: "STJ") {
    success
  }

  # Submeter formulário
  step5_click: click(selector: "input[type='submit'], button[type='submit']") {
    success
  }

  # Aguardar resultados (ou CAPTCHA)
  step6_waitForNavigation: waitForNavigation(waitUntil: networkIdle, timeout: 30000) {
    success
  }

  # Verificar se há CAPTCHA
  step7_captchaPresent: evaluate(
    content: "return document.querySelector('.g-recaptcha, iframe[src*=\"recaptcha\"]') !== null;"
  ) {
    value
  }

  # Extrair jurisprudências (se não houver CAPTCHA)
  step8_jurisprudencias: mapSelector(selector: ".jurisprudenciaResultado, .docEntryData") {

    # Número do processo
    numeroProcesso: mapSelector(selector: ".numeroProcesso, h4:nth-of-type(1)") {
      texto: innerText
    }

    # Data de publicação
    dataPublicacao: mapSelector(selector: ".dataPublicacao, .data") {
      texto: innerText
    }

    # Ementa
    ementa: mapSelector(selector: ".ementa, .docEntryData p") {
      texto: innerText
    }

    # Link para detalhes
    link: mapSelector(selector: "a") {
      href: attribute(name: "href") {
        value
      }
    }
  }

  # Capturar screenshot da página de resultados
  step9_screenshot: screenshot(fullPage: true) {
    base64
  }

  # Exportar HTML limpo dos resultados
  step10_resultsHtml: html(clean: {
    removeAttributes: true,
    removeNonTextNodes: true
  }) {
    html
  }

  # Contar número de resultados
  step11_resultCount: evaluate(
    content: "return document.querySelectorAll('.jurisprudenciaResultado, .docEntryData').length;"
  ) {
    value
  }
}

