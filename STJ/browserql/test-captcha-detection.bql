# ═══════════════════════════════════════════════════════════════════════
# TEST: Detecção e Resolução de CAPTCHA/Cloudflare
# ═══════════════════════════════════════════════════════════════════════
#
# OBJETIVO:
# Detectar e resolver Cloudflare Turnstile/Challenge na página do STJ.
#
# COMO USAR:
# 1. Acesse: https://www.browserless.io/playground
# 2. Configure sua API Key no botão ⚙️ Settings
# 3. IMPORTANTE: Ative "Residential Proxy" nas configurações (obrigatório para Cloudflare)
# 4. Cole esta query no editor
# 5. Clique em ▶️ Run
#
# RESULTADO ESPERADO:
# - Cloudflare Turnstile detectado e resolvido
# - Formulário STJ carregado após bypass
# - Screenshot mostrando página final
#
# DOCUMENTAÇÃO:
# https://docs.browserless.io/browserql/bot-detection/solving-captchas
#
# TIPOS DE PROTEÇÃO DETECTADOS:
# - Cloudflare Turnstile (.cf-turnstile)
# - Cloudflare Challenge Page (a[href*="cloudflare.com"])
# - reCAPTCHA v2/v3 (fallback)
# - hCaptcha (fallback)
# ═══════════════════════════════════════════════════════════════════════

mutation STJCloudflareBypass {

  # ═══════════════════════════════════════════════════════════════════════
  # ETAPA 1: Navegar para STJ com Proxy Residencial (OBRIGATÓRIO)
  # ═══════════════════════════════════════════════════════════════════════

  # Ativar proxy residencial do Brasil (obrigatório para Cloudflare)
  proxy(url: "*", country: BR) {
    time
  }

  # Navegar para página do STJ
  goto(url: "https://scon.stj.jus.br/SCON/jurisprudencia/toc.jsp", waitUntil: domContentLoaded) {
    status
  }

  # ═══════════════════════════════════════════════════════════════════════
  # ETAPA 2: Detectar e Resolver Cloudflare Challenge Page
  # ═══════════════════════════════════════════════════════════════════════

  # Aguardar 1 segundo para detectar se há página de challenge do Cloudflare
  waitForCloudflareChallenge: waitForSelector(
    selector: "a[href*='cloudflare.com']",
    timeout: 1000
  ) {
    time
  }

  # Se página de challenge do Cloudflare for detectada, resolver
  ifCloudflareChallenge: if(selector: "a[href*='cloudflare.com']") {

    # Resolver Cloudflare Challenge
    verifyChallenge: verify(type: cloudflare, timeout: 30000) {
      found
      solved
      time
    }

    # Aguardar navegação após resolução
    waitAfterChallenge: waitForNavigation(waitUntil: networkIdle, timeout: 30000) {
      status
      time
    }
  }

  # ═══════════════════════════════════════════════════════════════════════
  # ETAPA 3: Detectar e Resolver Cloudflare Turnstile
  # ═══════════════════════════════════════════════════════════════════════

  # Aguardar 1 segundo para detectar se há Turnstile
  waitForTurnstile: waitForSelector(
    selector: ".cf-turnstile, iframe[src*='challenges.cloudflare.com']",
    timeout: 1000
  ) {
    time
  }

  # Se Turnstile for detectado, resolver
  ifTurnstile: if(selector: ".cf-turnstile, iframe[src*='challenges.cloudflare.com']") {

    # Resolver Cloudflare Turnstile
    verifyTurnstile: verify(type: cloudflare, timeout: 30000) {
      found
      solved
      time
    }

    # Aguardar 2 segundos após resolução
    waitAfterTurnstile: waitForTimeout(time: 2000) {
      time
    }
  }

  # ═══════════════════════════════════════════════════════════════════════
  # ETAPA 4: Fallback - Resolver reCAPTCHA/hCaptcha (se presente)
  # ═══════════════════════════════════════════════════════════════════════

  # Aguardar 1 segundo para detectar reCAPTCHA
  waitForRecaptcha: waitForSelector(
    selector: ".g-recaptcha, iframe[src*='recaptcha']",
    timeout: 1000
  ) {
    time
  }

  # Se reCAPTCHA for detectado, resolver
  ifRecaptcha: if(selector: ".g-recaptcha, iframe[src*='recaptcha']") {

    # Resolver reCAPTCHA (auto-detecta v2/v3)
    solveRecaptcha: solve(timeout: 60000) {
      found
      solved
      time
    }
  }

  # ═══════════════════════════════════════════════════════════════════════
  # ETAPA 5: Validar que Formulário STJ Carregou
  # ═══════════════════════════════════════════════════════════════════════

  # Aguardar formulário aparecer (timeout maior para dar tempo do Cloudflare processar)
  waitForForm: waitForSelector(
    selector: "input[name='livre']",
    timeout: 10000
  ) {
    time
  }

  # Validar que todos os campos do formulário existem
  formValidation: evaluate(
    content: "const selectors = { tribunal: document.querySelector('select[name=\"b\"]') !== null, livre: document.querySelector('input[name=\"livre\"]') !== null, processo: document.querySelector('input[name=\"processo\"]') !== null, submitButton: document.querySelector('input[type=\"submit\"], button[type=\"submit\"]') !== null }; const missing = Object.entries(selectors).filter(([key, exists]) => !exists).map(([key]) => key); return { formLoaded: missing.length === 0, found: Object.values(selectors).filter(v => v).length, total: Object.keys(selectors).length, missing: missing.join(', ') || 'none', pageTitle: document.title, currentUrl: window.location.href };"
  ) {
    value
  }

  # ═══════════════════════════════════════════════════════════════════════
  # ETAPA 6: Capturar Evidências
  # ═══════════════════════════════════════════════════════════════════════

  # Título da página (deve ser diferente de "Just a moment...")
  pageTitle: title {
    title
  }

  # Screenshot da página final
  screenshot(fullPage: true) {
    base64
  }

  # HTML do formulário (se carregou)
  formHtml: html(selector: "form", clean: {
    removeAttributes: false,
    removeNonTextNodes: false
  }) {
    html
  }
}