# ═══════════════════════════════════════════════════════════════════════
# TEST: Navegação entre Páginas (Paginação)
# ═══════════════════════════════════════════════════════════════════════
#
# OBJETIVO:
# Testar a navegação entre páginas de resultados de jurisprudências do STJ.
#
# COMO USAR:
# 1. Acesse: https://www.browserless.io/playground
# 2. Configure sua API Key no botão ¦¦¦ (Settings)
# 3. Cole esta query no editor
# 4. Clique em ▶️ Run
#
# RESULTADO ESPERADO:
# - Formulário preenchido e submetido
# - Navegação para página 2
# - Screenshot da página 2
# - Informações sobre paginação
#
# SELETORES CSS USADOS:
# - .pagination - Container de paginação
# - .pagination a - Links de páginas
# - .pagination .active - Página atual
#
# NOTA:
# Esta query pode falhar se houver CAPTCHA. Use apenas para testes visuais.
# ═══════════════════════════════════════════════════════════════════════

mutation TestPagination {

  # Navegar para página de pesquisa do STJ
  step1_goto: goto(
    url: "https://scon.stj.jus.br/SCON/jurisprudencia/toc.jsp",
    waitUntil: networkIdle
  ) {
    status
  }

  # Aguardar carregamento do formulário
  step2_waitForSelector: waitForSelector(selector: "input[name='livre']", timeout: 10000) {
    success
  }

  # Preencher campo "Pesquisa livre"
  step3_type: type(selector: "input[name='livre']", text: "Advogado") {
    success
  }

  # Selecionar tribunal "STJ" (seletor correto: name="b")
  step4_select: select(selector: "select[name='b']", value: "STJ") {
    success
  }

  # Submeter formulário
  step5_click: click(selector: "input[type='submit'], button[type='submit']") {
    success
  }

  # Aguardar resultados
  step6_waitForNavigation: waitForNavigation(waitUntil: networkIdle, timeout: 30000) {
    success
  }

  # Capturar screenshot da página 1
  step7_screenshotPage1: screenshot(fullPage: true) {
    base64
  }

  # Verificar se há paginação
  step8_paginationExists: evaluate(
    content: "return document.querySelector('.pagination, .paginacao, a[href*=\"pagina\"]') !== null;"
  ) {
    value
  }

  # Contar número de páginas disponíveis
  step9_totalPages: evaluate(
    content: "return document.querySelectorAll('.pagination a, .paginacao a').length;"
  ) {
    value
  }

  # Obter número da página atual
  step10_currentPage: evaluate(
    content: "return document.querySelector('.pagination .active, .paginacao .active')?.innerText || '1';"
  ) {
    value
  }

  # Clicar no link da página 2 (se existir)
  step11_clickPage2: click(selector: ".pagination a:nth-of-type(2), .paginacao a:nth-of-type(2), a[href*='pagina=2']") {
    success
  }

  # Aguardar navegação para página 2
  step12_waitForPage2: waitForNavigation(waitUntil: networkIdle, timeout: 30000) {
    success
  }

  # Capturar screenshot da página 2
  step13_screenshotPage2: screenshot(fullPage: true) {
    base64
  }

  # Verificar número da página atual após navegação
  step14_currentPageAfter: evaluate(
    content: "return document.querySelector('.pagination .active, .paginacao .active')?.innerText || 'N/A';"
  ) {
    value
  }

  # Contar resultados na página 2
  step15_resultsPage2: evaluate(
    content: "return document.querySelectorAll('.jurisprudenciaResultado, .docEntryData').length;"
  ) {
    value
  }
}

