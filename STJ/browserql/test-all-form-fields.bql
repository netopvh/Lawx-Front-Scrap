# ═══════════════════════════════════════════════════════════════════════
# TEST: Todos os Campos do Formulário STJ
# ═══════════════════════════════════════════════════════════════════════
#
# OBJETIVO:
# Testar TODOS os campos do formulário de pesquisa avançada do STJ.
# Esta query mapeia EXATAMENTE os seletores usados em STJ/index.js.
#
# COMO USAR:
# 1. Acesse: https://www.browserless.io/playground
# 2. Configure sua API Key no botão ¦¦¦ (Settings)
# 3. Cole esta query no editor
# 4. Clique em ▶️ Run
#
# RESULTADO ESPERADO:
# - Todos os campos preenchidos
# - Screenshot mostrando o formulário completo
# - Validação de que todos os seletores existem
#
# SELETORES CSS MAPEADOS (baseados em STJ/index.js linhas 919-983):
# - select[name="b"] - Tribunal (STJ ou TFR) - linha 929
# - input[name="livre"] - Pesquisa livre - linha 935
# - input[name="processo"] - Número do processo - linha 941
# - input[name="classe"] - Classe processual - linha 947
# - select[name="uf"] - Unidade Federativa - linha 953
# - input[name="dtpb1"] - Data publicação início - linha 959
# - input[name="dtpb2"] - Data publicação fim - linha 963
# - input[name="dtde1"] - Data decisão início - linha 969
# - input[name="dtde2"] - Data decisão fim - linha 973
# - input[type="submit"] - Botão de submissão - linha 993
# ═══════════════════════════════════════════════════════════════════════

mutation TestAllFormFields {

  # Navegar para página de pesquisa do STJ
  step1_goto: goto(
    url: "https://scon.stj.jus.br/SCON/jurisprudencia/toc.jsp",
    waitUntil: networkIdle
  ) {
    status
  }

  # Aguardar carregamento do formulário
  step2_waitForSelector: waitForSelector(selector: "input[name='livre']", timeout: 10000) {
    success
  }
  
  # ═══════════════════════════════════════════════════════════════════════
  # PREENCHER TODOS OS CAMPOS
  # ═══════════════════════════════════════════════════════════════════════
  
  # 1. Selecionar tribunal "STJ" (seletor: name="b")
  step3_selectTribunal: select(selector: "select[name='b']", value: "STJ") {
    success
  }

  # 2. Preencher "Pesquisa livre"
  step4_typeLivre: type(selector: "input[name='livre']", text: "Advogado") {
    success
  }
  
  # 3. Preencher "Número do processo" (opcional - comentado para não filtrar muito)
  # typeProcesso: type(selector: "input[name='processo']", text: "REsp 1234567") {
  #   success
  # }
  
  # 4. Preencher "Classe processual" (opcional)
  # typeClasse: type(selector: "input[name='classe']", text: "Recurso Especial") {
  #   success
  # }
  
  # 5. Selecionar "Unidade Federativa" (opcional)
  # selectUF: select(selector: "select[name='uf']", value: "SP") {
  #   success
  # }
  
  # 6. Preencher "Data de publicação (início)" (opcional)
  # typeDtpb1: type(selector: "input[name='dtpb1']", text: "01/01/2024") {
  #   success
  # }
  
  # 7. Preencher "Data de publicação (fim)" (opcional)
  # typeDtpb2: type(selector: "input[name='dtpb2']", text: "31/12/2024") {
  #   success
  # }
  
  # 8. Preencher "Data de decisão (início)" (opcional)
  # typeDtde1: type(selector: "input[name='dtde1']", text: "01/01/2024") {
  #   success
  # }
  
  # 9. Preencher "Data de decisão (fim)" (opcional)
  # typeDtde2: type(selector: "input[name='dtde2']", text: "31/12/2024") {
  #   success
  # }
  
  # ═══════════════════════════════════════════════════════════════════════
  # VALIDAÇÕES
  # ═══════════════════════════════════════════════════════════════════════
  
  # Verificar se todos os seletores existem
  step5_validations: evaluate(
    content: "const selectors = { tribunal: document.querySelector('select[name=\"b\"]') !== null, livre: document.querySelector('input[name=\"livre\"]') !== null, processo: document.querySelector('input[name=\"processo\"]') !== null, classe: document.querySelector('input[name=\"classe\"]') !== null, uf: document.querySelector('select[name=\"uf\"]') !== null, dtpb1: document.querySelector('input[name=\"dtpb1\"]') !== null, dtpb2: document.querySelector('input[name=\"dtpb2\"]') !== null, dtde1: document.querySelector('input[name=\"dtde1\"]') !== null, dtde2: document.querySelector('input[name=\"dtde2\"]') !== null, submitButton: document.querySelector('input[type=\"submit\"], button[type=\"submit\"]') !== null }; const missing = Object.entries(selectors).filter(([key, exists]) => !exists).map(([key]) => key); return { allFound: missing.length === 0, found: Object.values(selectors).filter(v => v).length, total: Object.keys(selectors).length, missing: missing.join(', ') || 'none' };"
  ) {
    value
  }

  # Verificar opções do dropdown de tribunal
  step6_tribunalOptions: evaluate(
    content: "const select = document.querySelector('select[name=\"b\"]'); if (!select) return 'Seletor não encontrado'; const options = Array.from(select.options).map(opt => ({ value: opt.value, text: opt.text })); return JSON.stringify(options);"
  ) {
    value
  }

  # Verificar opções do dropdown de UF
  step7_ufOptions: evaluate(
    content: "const select = document.querySelector('select[name=\"uf\"]'); if (!select) return 'Seletor não encontrado'; const options = Array.from(select.options).slice(0, 5).map(opt => opt.value + ': ' + opt.text); return options.join(', ');"
  ) {
    value
  }
  
  # Aguardar 2 segundos para visualizar
  step8_wait: waitForTimeout(time: 2000) {
    time
  }

  # Capturar screenshot do formulário preenchido
  step9_screenshot: screenshot(fullPage: true) {
    base64
  }

  # Verificar se o CAPTCHA está presente
  step10_captchaDetected: evaluate(
    content: "return document.querySelector('.g-recaptcha, iframe[src*=\"recaptcha\"], .cf-turnstile') !== null;"
  ) {
    value
  }

  # Exportar HTML do formulário
  step11_formHtml: html(selector: "form", clean: {
    removeAttributes: false,
    removeNonTextNodes: false
  }) {
    html
  }
}

