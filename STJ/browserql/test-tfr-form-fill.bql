# ═══════════════════════════════════════════════════════════════════════
# TEST: Preenchimento de Formulário TFR
# ═══════════════════════════════════════════════════════════════════════
#
# OBJETIVO:
# Testar o preenchimento do formulário de pesquisa de jurisprudências do TFR.
#
# COMO USAR:
# 1. Acesse: https://www.browserless.io/playground
# 2. Configure sua API Key no botão ¦¦¦ (Settings)
# 3. Cole esta query no editor
# 4. Clique em ▶️ Run
#
# RESULTADO ESPERADO:
# - Formulário preenchido com "Advogado" no campo "Pesquisa livre"
# - Tribunal "TFR" selecionado
# - Screenshot mostrando o formulário preenchido
#
# SELETORES CSS USADOS (baseados em STJ/index.js):
# - input[name="livre"] - Campo de pesquisa livre
# - select[name="b"] - Dropdown de seleção de tribunal (STJ ou TFR)
# - input[type="submit"] - Botão de submissão do formulário
#
# NOTA:
# O TFR (Tribunal Federal de Recursos) foi extinto em 1989 e suas competências
# foram transferidas para o STJ. As jurisprudências do TFR estão disponíveis
# no mesmo sistema do STJ.
# ═══════════════════════════════════════════════════════════════════════

mutation TestTFRFormFill {

  # Navegar para página de pesquisa do STJ/TFR
  step1_goto: goto(
    url: "https://scon.stj.jus.br/SCON/jurisprudencia/toc.jsp",
    waitUntil: networkIdle
  ) {
    status
  }

  # Aguardar carregamento do formulário
  step2_waitForSelector: waitForSelector(selector: "input[name='livre']", timeout: 10000) {
    success
  }

  # Preencher campo "Pesquisa livre"
  step3_type: type(selector: "input[name='livre']", text: "Advogado") {
    success
  }

  # Selecionar tribunal "TFR" (seletor correto: name="b")
  step4_select: select(selector: "select[name='b']", value: "TFR") {
    success
  }

  # Aguardar 2 segundos para visualizar
  step5_wait: waitForTimeout(time: 2000) {
    time
  }

  # Capturar screenshot do formulário preenchido
  step6_screenshot: screenshot(fullPage: true) {
    base64
  }

  # Verificar se o CAPTCHA está presente
  step7_captchaDetected: evaluate(
    content: "return document.querySelector('.g-recaptcha') !== null;"
  ) {
    value
  }

  # Verificar se a opção TFR existe no dropdown (seletor correto: name="b")
  step8_tfrOptionExists: evaluate(
    content: "return Array.from(document.querySelectorAll('select[name=\"b\"] option')).some(opt => opt.value === 'TFR');"
  ) {
    value
  }

  # Exportar HTML do formulário
  step9_formHtml: html(selector: "form", clean: {
    removeAttributes: false,
    removeNonTextNodes: false
  }) {
    html
  }
}

