# ═══════════════════════════════════════════════════════════════════════
# TEST: Conexão Básica com Browserless
# ═══════════════════════════════════════════════════════════════════════
#
# OBJETIVO:
# Testar se a conexão com o Browserless está funcionando corretamente.
#
# COMO USAR:
# 1. Acesse: https://www.browserless.io/playground
# 2. Configure sua API Key no botão ¦¦¦ (Settings)
# 3. Cole esta query no editor
# 4. Clique em ▶️ Run
#
# RESULTADO ESPERADO:
# - Status 200
# - Título: "Example Domain"
# - Screenshot da página
# ═══════════════════════════════════════════════════════════════════════

mutation TestConnection {
  
  # Navegar para página de teste
  goto(url: "https://example.com", waitUntil: networkIdle) {
    status
  }
  
  # Obter título da página
  title {
    title
  }
  
  # Capturar screenshot
  screenshot(fullPage: true) {
    base64
  }
  
  # Exportar HTML limpo
  html(clean: {
    removeAttributes: true,
    removeNonTextNodes: true
  }) {
    html
  }
}

