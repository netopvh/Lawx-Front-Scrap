# Scrapeless API Configuration
# Obtenha seu token em: https://scrapeless.com/
SCRAPELESS_TOKEN=sk_YOUR_TOKEN_HERE

# Scrapeless Browser Configuration
SCRAPELESS_PROXY_COUNTRY=BR
SCRAPELESS_SESSION_RECORDING=true
SCRAPELESS_SESSION_TTL=900
SCRAPELESS_SESSION_NAME=TJSP Scraper - Cloudflare Turnstile

# TJSP URL
TJSP_URL=https://esaj.tjsp.jus.br/cjsg/resultadoCompleta.do

# OpenAI API Configuration
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Pinecone Vector Database Configuration
# Obtenha sua chave em: https://app.pinecone.io/
# O índice será criado automaticamente se não existir
PINECONE_API_KEY=pcsk_YOUR_PINECONE_API_KEY_HERE
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws
PINECONE_INDEX_NAME=jurisprudencias-tjsp
PINECONE_DIMENSION=1536
PINECONE_TYPE=DENSE
PINECONE_CAPACITY_MODE=SERVERLESS

