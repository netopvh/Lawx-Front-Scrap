# ═══════════════════════════════════════════════════════════════════════
# STF SCRAPER - CONFIGURAÇÃO DE AMBIENTE
# ═══════════════════════════════════════════════════════════════════════
#
# Este arquivo contém as variáveis de ambiente necessárias para o scraper.
# Copie este arquivo para `.env` e preencha com seus valores reais.
#
# IMPORTANTE: Nunca commite o arquivo `.env` no Git!
#
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────
# SCRAPELESS API CONFIGURATION (OBRIGATÓRIO)
# ───────────────────────────────────────────────────────────────────────
# Token da API Scrapeless
# Obtenha em: https://scrapeless.com/
SCRAPELESS_TOKEN=sk_SEU_TOKEN_AQUI

# ───────────────────────────────────────────────────────────────────────
# SCRAPELESS BROWSER CONFIGURATION (OPCIONAL)
# ───────────────────────────────────────────────────────────────────────
# IMPORTANTE: NÃO use SCRAPELESS_PROXY_COUNTRY=BR pois causa erros de túnel
# O Scrapeless escolhe automaticamente o melhor proxy

# Gravar sessão do navegador (útil para debug)
SCRAPELESS_SESSION_RECORDING=true

# Tempo de vida da sessão em segundos (900 = 15 minutos)
SCRAPELESS_SESSION_TTL=900

# Nome da sessão (aparece no dashboard do Scrapeless)
SCRAPELESS_SESSION_NAME=STF Scraper - Cloud Browser

# ───────────────────────────────────────────────────────────────────────
# STF URL BASE (OPCIONAL)
# ───────────────────────────────────────────────────────────────────────
# URL base do site do STF
# Normalmente não precisa alterar
STF_URL=https://jurisprudencia.stf.jus.br/pages/search

# ═══════════════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES
# ═══════════════════════════════════════════════════════════════════════
#
# 1. AWS WAF Challenge:
#    - O site do STF usa AWS WAF (Web Application Firewall)
#    - O scraper detecta e aguarda resolução automática
#    - Não precisa configurar nada adicional
#
# 2. Sem CAPTCHA:
#    - O site do STF NÃO possui CAPTCHA
#    - Não precisa de configurações especiais de CAPTCHA
#
# 3. Proxy Country:
#    - NÃO adicione SCRAPELESS_PROXY_COUNTRY=BR
#    - Isso causa erros ERR_TUNNEL_CONNECTION_FAILED
#    - Deixe o Scrapeless escolher automaticamente
#
# 4. Custos:
#    - Verifique os créditos da sua conta Scrapeless
#    - Cada requisição consome créditos
#
# ═══════════════════════════════════════════════════════════════════════

